[Unit]
Description=B3 (BuildBrickBlocks) Build HAT daemon
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=b3
Group=b3
WorkingDirectory=/var/lib/b3
Environment=PYTHONPATH=/opt/b3/hatd
ExecStart=/usr/bin/python3 -P -m b3hatd --config /var/lib/b3/config.toml
Restart=on-failure
RestartSec=2
TimeoutStopSec=15
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/b3

[Install]
WantedBy=multi-user.target
